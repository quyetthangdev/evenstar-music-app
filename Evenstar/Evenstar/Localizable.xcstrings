    "Không có bài hát nào trong thư mục đã liên kết. Kéo xuống để quét lại, hoặc mở ⋯ để thêm thư mục khác.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No songs in the linked folder. Pull down to rescan, or open ⋯ to add another folder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có bài hát nào trong thư mục đã liên kết. Kéo xuống để quét lại, hoặc mở ⋯ để thêm thư mục khác."
          }
        }
      }
    },
    "Không có bài hát, nghệ sĩ hay album nào khớp với “%@”.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing matches “%@” — no song, artist or album."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có bài hát, nghệ sĩ hay album nào khớp với “%@”."
          }
        }
      }
    },
    "Không có kết nối mạng.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No network connection."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có kết nối mạng."
          }
        }
      }
    },
    "Không lưu được thay đổi: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save the changes: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không lưu được thay đổi: %@"
          }
        }
