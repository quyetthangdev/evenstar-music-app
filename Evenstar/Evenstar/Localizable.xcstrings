          }
        }
      }
    },
    "Không tìm thấy thư mục. Link có thể sai hoặc thư mục đã bị xoá.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder not found. The link may be wrong, or the folder was deleted."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy thư mục. Link có thể sai hoặc thư mục đã bị xoá."
          }
        }
      }
    },
    "Không tải được ảnh đã chọn.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load the selected image."
