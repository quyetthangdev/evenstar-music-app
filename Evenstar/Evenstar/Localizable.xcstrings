    "Không lưu được ảnh bìa: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save the artwork: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không lưu được ảnh bìa: %@"
          }
        }
      }
    },
    "Không mở được %@. File có thể đã bị di chuyển hoặc xoá.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open %@. It may have been moved or deleted."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không mở được %@. File có thể đã bị di chuyển hoặc xoá."
          }
        }
      }
    },
    "Không mở được file": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open those files"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không mở được file"
          }
        }
      }
    },
    "Không phát được bài này. Tệp có thể đã bị xoá khỏi Drive hoặc thư mục không còn được chia sẻ.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t play this track. The file may have been removed from Drive, or the folder is no longer shared."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không phát được bài này. Tệp có thể đã bị xoá khỏi Drive hoặc thư mục không còn được chia sẻ."
          }
        }
      }
    },
    "Không thể kết nối tới Google Drive. Vui lòng thử lại sau.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t reach Google Drive. Please try again later."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kết nối tới Google Drive. Vui lòng thử lại sau."
          }
        }
      }
    },
    "Không tìm thấy kết quả": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No results"
          }
