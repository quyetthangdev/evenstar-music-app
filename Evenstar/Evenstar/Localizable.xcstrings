      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save to the library: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không lưu được vào thư viện: %@"
          }
